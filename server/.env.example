PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL - Local or AWS RDS)
DATABASE_URL="postgresql://postgres:password@localhost:5432/codesphere?schema=public"

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AWS S3 Configuration (Optional for cloud storage)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=codesphere-project-files
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub Integration (Optional - increases GitHub REST API rate limits from 60 to 5,000 req/hr)
GITHUB_TOKEN=
